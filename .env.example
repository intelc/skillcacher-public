# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.
# Load before running deploy scripts:
#   set -a; source .env; set +a
#   bash scripts/deploy/provision.sh

# --- RunPod (required for provision.sh / teardown.sh) ---
# Get from: https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=

# --- Tailscale (required for bootstrap.sh) ---
# Generate a tagged ephemeral auth key:
#   https://login.tailscale.com/admin/settings/keys
# Recommended: ephemeral=true, reusable=false, tag:gpu (or similar)
TAILSCALE_AUTH_KEY=

# --- Hugging Face (required for bootstrap.sh model download) ---
# Get from: https://huggingface.co/settings/tokens
# Must have been granted access to meta-llama/Llama-3.3-70B-Instruct
# (request access at: https://huggingface.co/meta-llama/Llama-3.3-70B-Instruct)
HF_TOKEN=

# --- Optional overrides ---
# POD_NAME=skillcacher-bench
# VOLUME_ID=                 # persistent network volume; create once via RunPod console, paste id here
# GPU_TYPE=NVIDIA H100 80GB HBM3
